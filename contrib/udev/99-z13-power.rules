# Auto-switch power profile on AC plug/unplug.
#
# Drops to "quiet" (Silent) on battery, raises to "performance" (Turbo) on AC.
# Calls z13ctl to apply the profile, which writes platform_profile sysfs and
# lets the firmware manage TDP and fan curves for that profile.
#
# Requires: z13ctl installed at /usr/local/bin/z13ctl (`sudo make install`).
# udev rules run as root with a minimal PATH — /usr/local/bin is in that PATH,
# but ~, env, and user-local binaries are not reachable.
#
# Install:
#   sudo make install -C ~/Coding/z13ctl
#   sudo install -m 644 99-z13-power.rules /usr/lib/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --subsystem-match=power_supply
# Remove:
#   sudo rm /usr/lib/udev/rules.d/99-z13-power.rules && sudo udevadm control --reload-rules

SUBSYSTEM=="power_supply", ATTR{online}=="1", RUN+="/usr/local/bin/z13ctl profile performance"
SUBSYSTEM=="power_supply", ATTR{online}=="0", RUN+="/usr/local/bin/z13ctl profile quiet"
